@{
    ViewData["Title"] = "Welcome";
    Layout = "~/Views/Shared/_LandingLayout.cshtml";
}

<div class="landing-wrapper">
    <section class="landing-card" aria-labelledby="welcomeTitle">
        <div class="landing-copy">
            <div class="landing-brand">
                <span class="landing-logo" aria-hidden="true">K</span>
                <span class="landing-logo-text">KOKU</span>
            </div>

            <p class="landing-eyebrow">A calmer space for class updates</p>
            <h1 class="landing-title" id="welcomeTitle">Your class,<br />all in one place.</h1>

            <p class="landing-subtitle">
                Keep announcements, schedules, and learning resources easy to find&mdash;without
                digging through group chats.
            </p>

            <div class="landing-actions">
                <a asp-area="Identity" asp-page="/Account/Login"
                   class="btn btn-primary landing-btn">
                    Log in
                </a>
                <a asp-area="Identity" asp-page="/Account/Register"
                   class="btn btn-outline-teal landing-btn">
                    Register
                </a>
            </div>
        </div>

        <div class="landing-art">
            <img src="~/images/koku-logo.png"
                 alt="KOKU class mascot"
                 class="landing-mascot" />
        </div>
    </section>
</div>