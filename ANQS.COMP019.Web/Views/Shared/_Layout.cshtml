<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KOKU</title>

    @* Google Fonts: Plus Jakarta Sans *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ANQS.COMP019.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">

        @* ===== SIDEBAR ===== *@
        <aside class="sidebar" id="appSidebar">
            <div class="sidebar-brand">
                <a class="brand-link" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="brand-logo">K</div>
                    <span class="brand-name">KOKU</span>
                </a>
            </div>

            <nav class="sidebar-nav" aria-label="Main navigation">
                <p class="nav-section-label">Menu</p>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                            <span class="nav-label">Home</span>
                        </a>
                    </li>
                    @* Placeholder items — features TBD *@
                    <li class="nav-item">
                        <span class="nav-link nav-link-disabled" aria-disabled="true">
                            <span class="nav-label">Announcements</span>
                        </span>
                    </li>
                    <li class="nav-item">
                        <span class="nav-link nav-link-disabled" aria-disabled="true">
                            <span class="nav-label">Schedules</span>
                        </span>
                    </li>
                    <li class="nav-item">
                        <span class="nav-link nav-link-disabled" aria-disabled="true">
                            <span class="nav-label">Resources</span>
                        </span>
                    </li>
                </ul>
            </nav>

            <div class="sidebar-footer">
                <partial name="_LoginPartial" />
            </div>
        </aside>

        @* ===== MAIN PANEL ===== *@
        <div class="main-panel">
            <header class="topbar">
                <button class="sidebar-toggle" id="sidebarToggle"
                        aria-label="Toggle navigation"
                        aria-expanded="false"
                        aria-controls="appSidebar">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <div class="topbar-title">@ViewData["Title"]</div>
            </header>

            <main class="content-area" role="main">
                @RenderBody()
            </main>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
